# ============================================================
# SALIN menjadi deploy/hosting.env lalu isi sesuai akun Anda.
# File ini TIDAK boleh diunggah ke publik / repository.
# ============================================================

# Metode akses: ssh | ftp | cpanel
HOSTING_METHOD=ssh

# --- Jika HOSTING_METHOD=ssh ---
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
# Jika hanya punya password, isi di sini (kurang disarankan):
SSH_PASSWORD=

# --- Jika HOSTING_METHOD=ftp ---
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_SSL=0

# --- Jika HOSTING_METHOD=cpanel ---
CPANEL_URL=
CPANEL_USER=
CPANEL_API_TOKEN=

# --- Domain & folder tujuan ---
DOMAIN=berkahrasa.ifree.page
DOCROOT=public_html

# --- Database hosting (kosongkan bila ingin dibuatkan lewat panel) ---
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# --- Konfigurasi aplikasi ---
APP_ENV=production
APP_DEBUG=0
APP_HTTPS=1
APP_BASE_URL=
WA_NUMBER=6281234567890
ENABLE_ADMINNEO=0
