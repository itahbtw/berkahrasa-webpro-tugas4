# ============================================================
# Berkah Rasa — konfigurasi Apache (XAMPP / shared hosting)
# ============================================================

Options -Indexes
DirectoryIndex index.php

# Jangan sajikan file konfigurasi, database, log, dan dokumentasi internal.
<FilesMatch "(^\.|\.env$|\.env\.|\.sql$|\.log$|\.md$|\.ini$|composer\.(json|lock)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Header keamanan untuk berkas statis (PHP mengirim header sendiri).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Kompresi teks (opsional, aman bila modul tidak tersedia).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
