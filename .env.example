# ============================================================
# Salin file ini menjadi .env, lalu sesuaikan nilainya.
# File .env TIDAK boleh ikut diunggah ke repository / hosting publik.
# ============================================================

# Identitas aplikasi
APP_NAME="Berkah Rasa"

# local  -> tampilkan pesan galat & akun demo
# production -> sembunyikan detail galat (default)
APP_ENV=local
APP_DEBUG=1

# Isi 1 bila situs diakses lewat HTTPS (hosting produksi).
APP_HTTPS=0

# Kosongkan untuk deteksi otomatis subfolder XAMPP.
# Contoh: APP_BASE_URL="/Tugas4_umkm_web_kelompok_genap_WebPro_TI_C"
APP_BASE_URL=
APP_HOST=localhost

# Database MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=berkahrasa
DB_USER=berkah
DB_PASS=berkah123

# Nomor WhatsApp tujuan checkout (format 62..., tanpa + dan spasi)
WA_NUMBER=6281234567890

# AdminNeo adalah alat bantu database. Aktifkan hanya di lokal.
# Di produksi biarkan 0 dan jangan unggah adminneo*.php.
ENABLE_ADMINNEO=0
ADMINNEO_SERVER=berkahrasa
